# 环境变量配置示例
# 复制到项目根目录的 .env，服务启动时读取；不要提交真实密钥

# 默认不配置模型即为离线 Mock。接入移动云 MOMA 或其他 OpenAI 兼容文本接口时，
# 取消下面三行的注释并填写实际参数；基础地址不要包含 /chat/completions。
# AI_BASE_URL=https://your-openai-compatible-endpoint/v1
# AI_API_KEY=your-api-key-here
# AI_MODEL=your-model-name

# 如已填真实参数但临时需要离线演示，可设置 AI_MODE=mock；
# 使用真实接口可不设置 AI_MODE，或显式设置 AI_MODE=compatible。

# 服务端口（可选，默认 3000）
PORT=3000
